# Apache Airflow local development
AIRFLOW_UID=50000

# Replace with a strong URL-safe password
AIRFLOW_DB_PASSWORD=REPLACE_WITH_URL_SAFE_PASSWORD

# Replace with a strong administrator password
AIRFLOW_ADMIN_PASSWORD=REPLACE_WITH_ADMIN_PASSWORD

# Replace with a valid generated Fernet key
AIRFLOW_FERNET_KEY=REPLACE_WITH_VALID_FERNET_KEY
